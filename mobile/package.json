{
  "name": "splash-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Splash AI for Android",
  "scripts": {
    "sync": "node ../scripts/sync-shared.js && node scripts/copy-vendor.js",
    "setup": "npm run sync && npx cap add android && node scripts/patch-android.js && npx cap sync android",
    "apk": "npm run sync && node scripts/patch-android.js && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor-community/text-to-speech": "^4.1.1",
    "@capacitor-mlkit/barcode-scanning": "6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app-launcher": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/share": "^6.0.3",
    "mammoth": "1.13.0",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
